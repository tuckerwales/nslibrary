{
  "name": "@nslib/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "//files": "What `pnpm deploy` copies into the Docker image: the bundle and its data, not sources or tests.",
  "files": [
    "dist",
    "drizzle",
    "public"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/main.js --external:better-sqlite3 --external:usb --external:fsevents --banner:js=\"import{createRequire as __nslibCreateRequire}from'node:module';const require=__nslibCreateRequire(import.meta.url);\"",
    "seed": "tsx src/seed/cli.ts",
    "reset-password": "tsx src/main.ts reset-password",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@nslib/fixtures": "workspace:*",
    "@nslib/formats": "workspace:*",
    "@nslib/shared": "workspace:*",
    "@nslib/usb-host": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "p-queue": "^9.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2"
  }
}
