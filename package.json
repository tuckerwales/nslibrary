{
  "name": "nslibrary",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p packages/web",
    "build": "pnpm --filter @nslib/web build",
    "dev:server": "pnpm --filter @nslib/server dev",
    "dev:web": "pnpm --filter @nslib/web dev",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "^22.15.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
