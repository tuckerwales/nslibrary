<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="16"
    paddingLeft="30"
    paddingRight="30">
    <brls:Header
        id="header"
        width="auto"
        height="auto"
        marginRight="20"/>
    <brls:Label
        id="status"
        width="auto"
        height="auto"
        marginTop="10"
        marginRight="20"
        fontSize="18"
        visibility="gone"
        text=""/>
    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0"
        marginTop="4">
        <brls:Box
            id="list"
            width="auto"
            height="auto"
            axis="column"
            paddingRight="20"
            paddingBottom="24"/>
    </brls:ScrollingFrame>
</brls:Box>
